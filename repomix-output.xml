import React, { useState } from 'react';
import { Workshop, Attendee, ProjectStatus } from '../types';
import { Icons } from '../constants';
import { generateFollowUpMessage } from '../services/geminiService';

interface WorkshopDetailProps {
  workshop: Workshop;
  onBack: () => void;
}

