VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: some preview deploys use these names (also supported)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend Email Service (optional - enables actual email sending)
# Get your API key at https://resend.com/api-keys
VITE_RESEND_API_KEY=
# Optional: customize sender (default: onboarding@resend.dev)
# Note: You need a verified domain in Resend to use a custom from address
VITE_RESEND_FROM_EMAIL=
